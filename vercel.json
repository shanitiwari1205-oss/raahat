{
  "services": {
    "web": { "root": "frontend/", "framework": "vite" },
    "api": { "root": "backend/", "entrypoint": "app.main:app", "framework": "fastapi" }
  },
  "rewrites": [
    { "source": "/server/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
